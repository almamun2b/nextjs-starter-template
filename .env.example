NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional, server-only: backend origin for server-to-server calls (e.g. an
# internal hostname). Falls back to NEXT_PUBLIC_API_URL.
# API_URL=http://api.internal:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signing secret for the backend-issued access token. Must match the API.
# Used by the optimistic route gate in src/proxy.ts to read the role claim.
ACCESS_TOKEN_SECRET=secret
